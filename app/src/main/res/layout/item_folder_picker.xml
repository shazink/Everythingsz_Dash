<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folder_picker_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp">

        <View
            android:id="@+id/folder_picker_icon_bg"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_folder_icon" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_folder"
            app:tint="@color/primary"
            android:contentDescription="@string/add_folder" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_folder_picker_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/on_surface"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/icon_folder_selected"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_bookmark"
        app:tint="@color/primary"
        android:visibility="gone"
        android:contentDescription="@string/share_folder_selected" />

</LinearLayout>
