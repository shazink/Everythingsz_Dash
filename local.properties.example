## Copy this file to `local.properties` and set your Android SDK path.
## Android Studio usually creates `local.properties` automatically on first open.
#
# Windows:
# sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk
#
# macOS:
# sdk.dir=/Users/YourName/Library/Android/sdk
#
# Linux:
sdk.dir=/path/to/Android/Sdk
